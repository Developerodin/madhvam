# MongoDB — local Docker default; replace with Atlas/DocumentDB/EC2 URI in production
MONGODB_URI=mongodb://127.0.0.1:27017/madhavam

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Single admin account created by `npm run seed`
ADMIN_EMAIL=admin@earthwavesdevelopers.com
ADMIN_PASSWORD=change-me-admin-password

# Optional: JWT lifetime in seconds (default 8 hours)
# JWT_EXPIRES_IN=28800
